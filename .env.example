# Copie este arquivo para .env (que fica gitignored) e preencha os valores reais.
# NUNCA commitar o arquivo .env — apenas este .env.example, sem valores reais.

# URL do servidor Ollama local (padrão já funciona na maioria dos casos)
OLLAMA_BASE_URL=http://localhost:11434

# Modelos usados no projeto
MODEL_PRINCIPAL=gpt-oss:120b
MODEL_COMPARACAO=qwen3:8b

# Se algum provider adicional exigir chave de API (ex.: bônus multi-provider
# com um provider externo), declare aqui SEM colocar o valor real:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
